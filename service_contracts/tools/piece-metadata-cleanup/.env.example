# Copy to .env and fill in. A variable set in the shell wins over this file.

# Indexer Postgres, read by `fetch` only. Use DATABASE_URL or the PG* variables.
# DATABASE_URL=postgres://user:password@host:5432/database
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# JSON-RPC endpoint. Default: the public Glif endpoint of the network.
# RPC_URL=

# Signing key, read by `send` only. Prefer to set it in the shell for that command.
# CLEANUP_PRIVATE_KEY=
